#include <iostream>
using namespace std;

int main() {
    int rows1, col1, rows2, col2;

    cout << "Enter rows of Matrix 1:";
    cin >> rows1;
    cout << "Enter coloumns of Matrix 1:";
    cin >> col1;

    cout << "Enter rows of Matrix 2:";
    cin >> rows2;
    cout << "Enter coloumns of Matrix 2:";
    cin >> col2;

    if (col1 != rows2) {
        cout << "Matrix multiplication is not possible!";
        return 0;
    }

    int a[10][10], b[10][10], c[20][20] = {0};

    cout << "Enter 1st:" << endl;
    for (int i = 0; i < rows1; i++)
        for (int j = 0; j < col1; j++)
            cin >> a[i][j];

    cout << "Enter 2nd:" << endl;
    for (int i = 0; i < rows2; i++)
        for (int j = 0; j < col2; j++)
            cin >> b[i][j];

    for (int i = 0; i < rows1; i++) {
        for (int j = 0; j < col2; j++) {
            for (int k = 0; k < col1; k++)
                c[i][j] += a[i][k] * b[k][j];
        }
    }

    cout << endl << "Resultant Matrix:" << endl;
    for (int i = 0; i < rows1; i++) {
        for (int j = 0; j < col2; j++) {
            cout << c[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
